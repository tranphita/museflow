{
  "manifest_version": 3,
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "name": "Museta",
  "version": "0.11.0",
  "description": "Museta visual workflow canvas for your signed-in Muse.ai session.",
  "action": { "default_title": "Open Museta", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "scripting", "power"],
  "host_permissions": ["https://muse.ai/*", "https://*.muse.ai/*"],
  "content_scripts": [{
    "matches": ["https://muse.ai/*", "https://*.muse.ai/*"],
    "js": ["bridge/muse-ui.js", "bridge/refusal.js", "bridge/muse-bridge.js"],
    "run_at": "document_idle"
  }]
}
